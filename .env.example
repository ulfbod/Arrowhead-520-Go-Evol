# .env.example — copy to .env and fill in values.
# All variables with defaults listed here; override as needed.
# Never commit .env to version control.

# ── Core (ADAPT stack) ───────────────────────────────────────────────────────
AUTHZ_PDP_ADDR=localhost:9550          # authz-pdp gRPC address
AUTHZFORCE_URL=http://authzforce:8080/authzforce-ce
AUTHZFORCE_DOMAIN=arrowhead-520        # XACML policy domain
SR_URL=http://localhost:8080           # ServiceRegistry base URL
CA_URL=http://localhost:8082           # ConsumerAuthorization base URL
AUTH_BACKEND=grpc                      # grpc | consumerauth
ENABLE_AUTH=true                       # true | false (bypass auth for dev)

# ── Foundation (AH5 systems) ─────────────────────────────────────────────────
SR_PORT=8080
AUTH_PORT=8081
CA_PORT=8082
DB_PATH=:memory:                       # SQLite path (or :memory:)

# ── Profile-CA (CA-as-PIP) ───────────────────────────────────────────────────
PROFILE_CA_PORT=8787                   # HTTP (CA + PIP endpoints)
PROFILE_CA_TLS_PORT=8788               # mTLS (profile-enforced issuance)
CA_KEY_FILE=/data/ca.key               # Persisted CA key

# ── PEP Services ─────────────────────────────────────────────────────────────
PIP_URL=http://profile-ca:8787         # All PEPs query profile-ca for cert attributes
CACHE_TTL=0s                           # PEP cache TTL (0s = no caching, instant revocation)

# ── Message Brokers ──────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=admin

# ── PAP ──────────────────────────────────────────────────────────────────────
PAP_PORT=9505

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
